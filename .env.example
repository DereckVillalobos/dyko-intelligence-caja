# DYKO Caja: variables privadas del servidor (Vercel > Project Settings > Environment Variables).
# No subir valores reales al repositorio ni exponerlos con prefijos VITE_*.
# Es obligatorio antes de aceptar datos reales en producción.
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/base?sslmode=require

# Se exige para crear el primer gerente en producción: mínimo 32 caracteres aleatorios.
# Ejemplo en Node: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# El código se introduce una sola vez en el formulario inicial; NO es el PIN del gerente.
DYKO_SETUP_CODE=reemplazar_por_secreto_aleatorio_de_32_caracteres_o_mas

# Sesiones seguras: será necesario después de incorporar los parches de autenticación.
# SESSION_SECRET=otro_secreto_aleatorio_independiente_de_minimo_32_caracteres
DB_POOL_MAX=3
